rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLnuEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@lnu\\.edu\\.ph$');
    }

    function isOwner(uid) {
      return isLnuEmail() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /profiles/{uid} {
      allow read: if isLnuEmail();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if isLnuEmail();
      allow create: if isLnuEmail()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.caption is string
        && request.resource.data.type in [
          'Artwork showcase',
          'Commission open post',
          'Service promotion',
          'Progress update',
          'Announcement'
        ]
        && request.resource.data.heartCount == 0
        && request.resource.data.viewCount == 0
        && request.resource.data.shareCount == 0;
      allow update: if isLnuEmail()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'heartCount',
          'viewCount',
          'shareCount',
          'updatedAt'
        ]);
      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;
    }

    match /post_reactions/{reactionId} {
      allow read: if isLnuEmail();
      allow create: if isLnuEmail()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type == 'heart';
      allow delete: if isLnuEmail()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /post_views/{viewId} {
      allow read: if isLnuEmail();
      allow create: if isLnuEmail()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /post_shares/{shareId} {
      allow read: if isLnuEmail();
      allow create: if isLnuEmail()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
